# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API, ou botão "Connect").
# Use a chave PÚBLICA ("anon" ou "publishable"). NUNCA a "service_role"/"secret".
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=cole-aqui-a-chave-publica
