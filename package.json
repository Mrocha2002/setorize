{
  "name": "equipeapp",
  "version": "2.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-font": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "lint": "expo lint",
    "test:banco": "node --test supabase/testes/rls.test.mjs",
    "test:tudo": "npm test && npm run test:banco"
  },
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.3.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/supabase/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/screens/**",
      "!src/components/**",
      "!src/navigation/**",
      "!src/theme/**",
      "!src/repositories/**",
      "!src/services/supabase.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
