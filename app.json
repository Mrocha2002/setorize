    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.metrocamp.equipe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
